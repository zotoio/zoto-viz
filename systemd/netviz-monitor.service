# User service: constant capture + discovery, serving the live UI on http://127.0.0.1:8765
#
#   mkdir -p ~/.config/systemd/user
#   cp systemd/netviz-monitor.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now netviz-monitor
#   loginctl enable-linger $USER          # keep it running when you are logged out
#   journalctl --user -u netviz-monitor -f
#
# Capture permission comes from the wireshark group (usermod -aG wireshark $USER, then re-login).
# The service falls back to `sg wireshark` when the session predates that change.

[Unit]
Description=netviz live network monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/git/net-test
ExecStart=%h/git/net-test/.venv/bin/python %h/git/net-test/monitor.py --bind 127.0.0.1 --port 8765
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# tshark stays inside the service cgroup, so stop/restart kills the capture too
KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=default.target
