{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoto.io/sdk/manifest-work-budget.schema.json",
  "title": "manifestWorkBudget",
  "description": "visualisation.yml workBudget per-frame caps. Host-owned ceilings live here (#45); #38+ edits this module only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "maxDrawCalls",
    "maxTriangles",
    "maxInstances",
    "maxGpuBytes",
    "maxSimStepsPerFrame",
    "maxPacketsPerFrame"
  ],
  "properties": {
    "maxDrawCalls": { "type": "integer", "minimum": 0, "maximum": 256 },
    "maxTriangles": { "type": "integer", "minimum": 0, "maximum": 2000000 },
    "maxInstances": { "type": "integer", "minimum": 0, "maximum": 256 },
    "maxGpuBytes": { "type": "integer", "minimum": 0, "maximum": 67108864 },
    "maxSimStepsPerFrame": { "type": "integer", "minimum": 0, "maximum": 32 },
    "maxPacketsPerFrame": { "type": "integer", "minimum": 0, "maximum": 128 }
  }
}
