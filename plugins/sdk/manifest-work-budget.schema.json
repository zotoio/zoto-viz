{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoto.io/sdk/manifest-work-budget.schema.json",
  "title": "manifestWorkBudget",
  "description": "visualisation.yml workBudget per-frame caps (shape only). Host ceilings: service/policy/work-budget-ceilings.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "maxDrawCalls",
    "maxTriangles",
    "maxInstances",
    "maxGpuBytes",
    "maxSimStepsPerFrame",
    "maxPacketsPerFrame"
  ],
  "properties": {
    "maxDrawCalls": { "type": "integer", "minimum": 0 },
    "maxTriangles": { "type": "integer", "minimum": 0 },
    "maxInstances": { "type": "integer", "minimum": 0 },
    "maxGpuBytes": { "type": "integer", "minimum": 0 },
    "maxSimStepsPerFrame": { "type": "integer", "minimum": 0 },
    "maxPacketsPerFrame": { "type": "integer", "minimum": 0 }
  }
}
