# Monitor / host environment (never commit a real key)
#
# TypeSafe / Jev Sense — read by the monitor proxy at POST /api/typesafe/sense.
# The browser never receives this value.
TYPESAFE_API_KEY=

# NASA APOD (api.nasa.gov). Env wins over ~/.zoto-viz/host.env; never sent to the browser.
NASA_API_KEY=

# Cursor SDK (agent + HN Rain title stills). Env wins over ~/.zoto-viz/cursor-key.
CURSOR_API_KEY=

# Nest Device Access lives in ~/.zoto-viz/sdm.yml (not env). See docs/sdm.md.
