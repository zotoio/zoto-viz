{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoto-viz.local/schema/agent-plugin.schema.json",
  "title": "zoto-viz agent plugin",
  "description": "Zip bundle of an Agent Skills tree (skills/, scripts, UI). Installed via the loopback MCP tool install_plugin_zip.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "produces", "consumes", "scripts", "ui"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 48 },
    "version": { "type": "integer", "minimum": 1 },
    "hint": { "type": "string", "maxLength": 280 },
    "produces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stream" },
      "description": "Datastream types this plugin emits."
    },
    "consumes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stream" },
      "description": "Datastream types this plugin reads."
    },
    "engine": {
      "type": "string",
      "enum": ["graph", "netpong", "invaders", "command", "frogger", "cpupong"],
      "default": "graph"
    },
    "base": {
      "type": "string",
      "enum": ["topology", "talkers", "services", "protocols", "layers", "watch", "wifi", "bluetooth", "cpu", "cores", "load"]
    },
    "capabilities": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["graph.read", "graph.style", "ui.overlay", "config.read"]
      }
    },
    "scripts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frontend", "backend"],
      "properties": {
        "frontend": {
          "type": "string",
          "pattern": "^scripts/frontend/[A-Za-z0-9._/-]+\\.ts$",
          "maxLength": 80
        },
        "backend": {
          "type": "string",
          "pattern": "^scripts/backend/[A-Za-z0-9._/-]+\\.py$",
          "maxLength": 80
        }
      }
    },
    "ui": {
      "oneOf": [
        { "$ref": "#/$defs/uiTypescript" },
        { "$ref": "#/$defs/uiPrompt" }
      ]
    },
    "skills": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^skills/[A-Za-z0-9._/-]+$",
        "maxLength": 80
      }
    }
  },
  "$defs": {
    "stream": {
      "type": "string",
      "enum": [
        "devices", "flows", "packets", "traffic", "wifi", "bluetooth",
        "cpu", "audio", "feed", "graph", "hud", "plugin_state", "rf"
      ]
    },
    "uiTypescript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "entry", "tests"],
      "properties": {
        "kind": { "const": "typescript" },
        "entry": {
          "type": "string",
          "pattern": "^ui/[A-Za-z0-9._/-]+\\.ts$",
          "maxLength": 80
        },
        "tests": {
          "type": "string",
          "pattern": "^ui/[A-Za-z0-9._/-]+\\.test\\.ts$",
          "maxLength": 80
        }
      }
    },
    "uiPrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "skill", "prompt"],
      "properties": {
        "kind": { "const": "prompt" },
        "skill": {
          "type": "string",
          "pattern": "^skills/[A-Za-z0-9._/-]+/SKILL\\.md$",
          "maxLength": 80
        },
        "prompt": {
          "type": "string",
          "pattern": "^ui/[A-Za-z0-9._/-]+\\.md$",
          "maxLength": 80
        }
      }
    }
  }
}
