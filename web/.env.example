# TypeSafe / Jev Sense (optional — dark-by-default without a key)
#
# VITE_* vars are embedded in the client bundle. Fine for local/demo; do not ship
# a production org key in a public deploy.
VITE_TYPESAFE_API_KEY=

# Optional alias — also exposed via vite.config.ts envPrefix (TYPESAFE_*).
TYPESAFE_API_KEY=
