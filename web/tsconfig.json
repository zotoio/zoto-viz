{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src",
    "typecheck/**/*.ts",
    "../shared/nixie-tubes.ts",
    "../plugins/src/hn-term/frontend/teletype.ts",
    "../plugins/src/stereo-gram/frontend/drive.ts",
    "../plugins/src/backrooms/frontend/director.ts",
    "../plugins/src/stereo-gram/frontend/recipe.ts",
    "../plugins/src/syscon/frontend/telemetry.ts",
    "../plugins/src/nixie-clock/frontend/tubes.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/graph/pack-mirror-readback.harness.ts",
    "src/graph/pack-mirror-readback-chrome.ts",
    "src/graph/photo-sky-registry.ts",
    "src/graph/shader-fallback-test-helpers.ts",
    "src/plugins/plugin-sky-smoke-render.ts",
    "src/plugins/starter-pack-pipeline.ts",
    "src/plugins/test/**",
    "src/plugins/tile-health-monitor.ts",
    "src/app/__tests__/**"
  ]
}
