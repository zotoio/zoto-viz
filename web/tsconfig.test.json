{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // #192: JS files the test program includes explicitly are part of it; only those with // @ts-check
    // are type-checked (checkJs stays off).
    "allowJs": true,
    "types": ["vite/client", "vitest/globals", "node"],
    "paths": {
      "plugins/sdk/*": ["../plugins/sdk/*"],
      // #192: test files under plugins/ import vitest but have no node_modules above them. Map it to
      // web's own install (the pnpm link; tsc follows it to the realpath web already resolves).
      "vitest": ["./node_modules/vitest"],
      "vitest/*": ["./node_modules/vitest/*"]
    }
  },
  "include": [
    // #192: every test file the tsgap error metric counts (web/src, plugins/src, plugins/sdk, scripts/,
    // web/scripts) is type-checked by default; new test files are covered without editing this file.
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "scripts/**/*.test.ts",
    "scripts/**/*.test.tsx",
    "../plugins/src/**/*.test.ts",
    "../plugins/src/**/*.test.tsx",
    "../plugins/sdk/**/*.test.ts",
    "../plugins/sdk/**/*.test.tsx",
    "../scripts/**/*.test.ts",
    "../scripts/**/*.test.tsx",
    // Non-test sources and declarations the test program needs to resolve.
    "../plugins/sdk/pack-bundle-resolve.mjs",
    "../plugins/sdk/pack-lint-import.ts",
    "../plugins/sdk/pack-lint.ts",
    "../plugins/src/ant-colony/frontend/index.ts",
    "../plugins/src/aquarium/frontend/aquarium.ts",
    "../plugins/src/aquarium/frontend/fixtures/idle-viz-frame.ts",
    "../plugins/src/blob-mesh/frontend/index.ts",
    "../plugins/src/cypher-cic/frontend/index.ts",
    "../plugins/src/fractal-zoom/frontend/index.ts",
    "../plugins/src/hn-term/frontend/index.ts",
    "../plugins/src/koi-pond/frontend/koi-pond.ts",
    "../plugins/src/rf-constellation/frontend/index.ts",
    "../plugins/src/rocket-car-soccer/frontend/index.ts",
    "../plugins/src/roto-proto/frontend/index.ts",
    "../plugins/src/talker-storm/frontend/index.ts",
    "scripts/lint-brand-casts-core.mjs",
    "src/app/__tests__/main-entry-harness.ts",
    "src/core/d3-force-3d.d.ts",
    "src/plugins/glsl-raw.d.ts",
    "src/ui/drawer-context.nest-devices-required.typecheck.ts",
    "test-support/mock-partial.ts",
    "test-support/pack-mirror-rect.boundary.ts",
    "test-support/test-cast-scan.ts",
    "test/node/pack-mirror-readback-chrome.ts",
    "test/node/pack-mirror-readback-vite.ts"
  ],
  // #192: test files excluded from the type-check. Guarded by src/tsconfig-test-exclude.test.ts
  // (every path must exist; one path per line, each block sorted).
  "exclude": [
    // SHRINK-ONLY: test files that still have tsc errors. Fix a file, then delete its line; never add
    // a path here (a new test file must type-check). Each path here must still have >= 1 tsc error.
    "src/app/consent-pack-start.test.ts",
    "src/app/consent-preserve-ubo.test.ts",
    "src/app/duplicate-slot-scope-note-guards.test.ts",
    "src/app/duplicate-slot-scope-note-live.test.ts",
    "src/app/duplicate-slot-scope-note-metrics.test.ts",
    "src/app/duplicate-slot-scope-note-slider.test.ts",
    "src/app/duplicate-slot-scope-note-sync.test.ts",
    "src/app/duplicate-slot-shared-config.test.ts",
    "src/app/main-present-opts-localstorage.test.ts",
    "src/app/main-wiring.test.ts",
    "src/app/main.wiring.test.ts",
    "src/app/mosaic-consent-resume.test.ts",
    "src/app/mosaic-host-bindings.test.ts",
    "src/app/mosaic-layout-settings-wiring.test.ts",
    "src/app/mosaic-settings-pane-pick-wire.test.ts",
    "src/app/mosaic-view-reload.test.ts",
    "src/app/needs-you-main.test.ts",
    "src/app/nest-cams-chips-stable.test.ts",
    "src/app/nest-cams-empty-devices.test.ts",
    "src/app/plugin-sandbox-config-push.test.ts",
    "src/app/sky-wait-drawn.test.ts",
    "src/app/switch-pane-view.test.ts",
    "src/app/tile-health-production.test.ts",
    "src/app/viz-frame-hot-path.test.ts",
    "src/app/viz-frame-scope.test.ts",
    "src/app/viz-frame-tick.test.ts",
    "src/app/viz-voxel-present-camera.test.ts",
    "src/plugins/consent.test.ts",
    "src/plugins/instances.test.ts",
    "src/plugins/nixie-clock-sky.test.ts",
    "src/plugins/nixie-wall-clock-source-rows.test.ts",
    "src/plugins/nixie-wall-clock.test.ts",
    "src/plugins/pack-asset-navigation-stop-clear.test.ts",
    "src/plugins/pack-frame-path.test.ts",
    "src/plugins/plugin-ui.test.ts",
    "src/plugins/plugin.test.ts",
    "src/plugins/recent-views.test.ts",
    "src/plugins/render-scale-host.test.ts",
    "src/plugins/sandbox-frame.security.test.ts",
    "src/plugins/sandbox-pack-bitmap.test.ts",
    "src/plugins/sandbox-write-path.counts.test.ts",
    "src/plugins/shipped-pack-sky.test.ts",
    "src/plugins/starter-pack-ci.test.ts",
    "src/plugins/tile-health-async.test.ts",
    "src/plugins/tile-health-floor.test.ts",
    "src/plugins/tile-health-monitor.test.ts",
    "src/plugins/tile-health.test.ts",
    "src/plugins/viz-build-gates.test.ts",
    "src/plugins/viz-frame-collect-index.test.ts",
    "src/plugins/viz-frame-collect.test.ts",
    "src/plugins/viz-frame-empty-links.test.ts",
    "src/plugins/viz-host.test.ts",
    "src/plugins/viz-publish-surface.test.ts",
    "src/plugins/viz-v1-frame-adapter.test.ts",
    // HELD (#192): scripts/revert-proof* is a held path. Do not fix, edit or move these files, and do
    // not remove them from this list; ask ZotoBoss. Exempt from the shrink-only rule above.
    "../scripts/revert-proof.dogfood.test.ts",
    "../scripts/revert-proof.lib.test.ts",
    "../scripts/revert-proof.test.ts"
  ]
}
