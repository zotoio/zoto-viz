{
  "runner": "vitest",
  "testFile": "scripts/revert-proof.lib.test.ts",
  "testName": "revert-proof pytest plugin > (4-plugin) a hand-raised AssertionError is not an assertion",
  "description": "Plugin accepts any failing statement in the test file, not only rewritten asserts",
  "red": {
    "actual": {
      "nodeid": "test_case.py::test_case",
      "outcome": "failed",
      "revertProofAssertion": true,
      "revertProofRed": {
        "assert": "raise AssertionError(\"answer == 2\")"
      }
    },
    "expected": {
      "nodeid": "test_case.py::test_case",
      "outcome": "failed",
      "revertProofAssertion": false,
      "revertProofRed": null
    }
  }
}
