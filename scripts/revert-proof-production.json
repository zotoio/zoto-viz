{
  "scanRoots": ["web/src", "plugins", "service", "packages"],
  "entryPoints": [
    "web/index.html",
    "web/src/app/main.ts",
    "web/src/camera/cam.worker.ts",
    "web/src/camera/sampler.ts",
    "service/monitor.py",
    ".github/workflows/ci.yml"
  ],
  "packEntryGlob": "plugins/src/*/frontend/index.ts",
  "reachExempt": ["scripts/revert-proof.mjs"]
}
