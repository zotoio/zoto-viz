    "stop:backend": "bash scripts/dev.sh stop backend",
    "stop:both": "bash scripts/dev.sh stop both",
    "restart": "bash scripts/dev.sh restart both",
    "restart:frontend": "bash scripts/dev.sh restart frontend",
    "restart:backend": "bash scripts/dev.sh restart backend",
    "restart:both": "bash scripts/dev.sh restart both",
    "dev:status": "bash scripts/dev.sh status both"
  }
