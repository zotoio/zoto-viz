{
  "name": "zoto-viz",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "bash scripts/dev.sh start both",
    "start:frontend": "bash scripts/dev.sh start frontend",
    "start:backend": "bash scripts/dev.sh start backend",
    "start:both": "bash scripts/dev.sh start both",
    "stop": "bash scripts/dev.sh stop both",
